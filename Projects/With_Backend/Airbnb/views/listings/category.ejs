<% layout("/layouts/boilerplate") %>

<div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of filteredListings) { %>
    <a href="/listings/<%=listing.id%>" class="listing-link">
      <div class="listing-card col">
      <img src="<%=listing.image.url%>" class="card-img-top" alt="listing image" style="height: 20rem"/>
      <div class="card-body">
        <p class="card-text">
          <p><b><%= listing.title %></b></p>
          <p>&#8377;<%= listing.price.toLocaleString("en-IN") %> / night</p>
        </p>
      </div>
      </div>
    </a>
  <% } %>
</div>